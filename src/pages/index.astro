---
import '../styles/global.css';
import { externalLinks, socialLinks } from '../content/links';

const navLinks = [
  {
    label: 'Resources',
    href: externalLinks.discord,
    external: true,
  },
  {
    label: 'Events',
    href: '#event',
    external: false,
  },
  {
    label: 'Agentic ML',
    href: '#agentic-ml',
    external: false,
  },
  {
    label: 'About',
    href: '/about',
    external: false,
  },
] as const;

const features = [
  {
    title: 'Practical discussions',
    body: 'Ask concrete questions about modeling, data quality, evaluation, deployment, and operating ML systems.',
  },
  {
    title: 'Learning & Growth',
    body: 'Build sharper engineering judgment through peer learning, shared resources, project reviews, and practical lessons from real ML work.',
  },
  {
    title: 'Content and resources',
    body: 'Find papers, guides, talks, implementation notes, and field-tested patterns worth your time.',
  },
  {
    title: 'Talks and events',
    body: 'Follow community sessions, meetups, recordings, and future live programming as MLEN grows.',
  },
];

const events = [
  {
    title: 'In-person meetups',
    body: 'Local gatherings for ML builders to meet, share work, and trade practical notes from the field.',
  },
  {
    title: 'Online sessions',
    body: 'Remote talks, workshops, and community calls for members who want to participate from anywhere.',
  },
  {
    title: 'Project demos',
    body: 'Lightweight show-and-tell sessions where members can present what they are building and get feedback.',
  },
];

const externalRel = 'noopener noreferrer';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="MLEN is a Discord community for machine learning engineers, students, builders, and practitioners."
    />
    <title>MLEN | Machine Learning Engineering Network</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="antialiased">
    <header class="py-5">
      <nav class="section-shell flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between" aria-label="Main navigation">
        <a href="/" class="header-link transition-colors duration-200 hover:text-leaf focus-visible:text-leaf">
          Machine Learning Engineering Network
        </a>
        <div class="flex w-full flex-wrap items-center justify-end gap-x-6 gap-y-3 sm:w-auto">
          {
            navLinks.map((link) => (
              <a
                class="header-link transition-colors duration-200 hover:text-leaf focus-visible:text-leaf"
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? externalRel : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main class="mt-8">
      <section class="section-shell grid gap-12 py-20 md:grid-cols-[0.95fr_0.85fr] md:items-start lg:py-28">
        <div class="reveal">
          <h1 class="max-w-4xl text-[38px] font-bold leading-[1.04] text-ink sm:text-[50px] lg:text-[62px]">
            The front door for ML engineers who want a practical community.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-muted sm:text-xl">
            MLEN is a community for machine learning engineers, builders, and practitioners. Join for peer discussion,
            useful content, and community events around real ML engineering work.
          </p>
          <a
            href={externalLinks.discord}
            target="_blank"
            rel={externalRel}
            class="group relative mt-8 inline-flex items-center justify-center overflow-hidden rounded-lg border-[3px] border-black bg-[#5ccbff] p-0.5 text-sm font-bold text-ink shadow-card transition hover:bg-[#35b8f5] hover:text-ink focus:outline-none focus:ring-4 focus:ring-[#5ccbff]/35"
          >
            <span class="relative inline-flex items-center gap-2 rounded-lg bg-[#5ccbff] px-5 py-3 leading-5 text-ink transition-all duration-75 ease-in group-hover:bg-[#35b8f5]">
              Join Discord
              <svg
                class="size-5"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M20.32 4.37A19.8 19.8 0 0 0 15.36 2.8a13.86 13.86 0 0 0-.64 1.31 18.38 18.38 0 0 0-5.44 0 12.6 12.6 0 0 0-.65-1.31 19.74 19.74 0 0 0-4.96 1.57C.54 9.03-.32 13.56.1 18.02a19.9 19.9 0 0 0 6.07 3.07 14.5 14.5 0 0 0 1.3-2.1 12.9 12.9 0 0 1-2.05-.98c.17-.13.34-.26.5-.4a14.18 14.18 0 0 0 12.16 0l.5.4c-.65.39-1.34.72-2.05.98.37.73.8 1.43 1.3 2.1a19.83 19.83 0 0 0 6.07-3.07c.5-5.17-.86-9.66-3.58-13.65ZM8.02 15.27c-1.18 0-2.15-1.08-2.15-2.42 0-1.33.95-2.42 2.15-2.42 1.2 0 2.17 1.1 2.15 2.42 0 1.34-.95 2.42-2.15 2.42Zm7.96 0c-1.18 0-2.15-1.08-2.15-2.42 0-1.33.95-2.42 2.15-2.42 1.2 0 2.17 1.1 2.15 2.42 0 1.34-.95 2.42-2.15 2.42Z" />
              </svg>
            </span>
          </a>
        </div>

        <div class="image-panel hero-logo-panel reveal" style="--reveal-delay: 120ms">
          <img
            src="/assets/community-network.png"
            alt="MLEN neural network brain logo"
            class="aspect-square w-full object-contain"
            loading="eager"
            decoding="async"
          />
        </div>
      </section>

      <section id="inside" class="section-shell py-20 sm:py-28">
        <div class="reveal">
          <p class="section-label">Inside the community</p>
          <h2 class="section-heading mt-4">
            Useful conversations for the work between notebooks and production.
          </h2>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            features.map((feature, index) => (
              <article class="soft-card reveal" style={`--reveal-delay: ${index * 80}ms`}>
                <div class="mb-5 h-1.5 w-12 rounded-full bg-leaf"></div>
                <h3 class="text-xl font-bold text-ink">{feature.title}</h3>
                <p class="mt-4 leading-7 text-muted">{feature.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="event" class="section-shell py-20 sm:py-28">
        <div class="reveal rounded-[2rem] bg-white px-5 py-8 shadow-soft sm:px-8 sm:py-12 lg:px-12">
          <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
            <div>
              <p class="section-label">Events</p>
              <h2 class="section-heading mt-4">
                Community programming online and in person.
              </h2>
              <p class="mt-5 leading-7 text-muted">
                Events are where MLEN turns discussion into shared context: talks, demos, meetups, reading groups, and
                hands-on sessions around practical ML engineering.
              </p>
            </div>
            <div class="grid gap-4">
              {
                events.map((event, index) => (
                  <article class="reveal rounded-2xl border border-sky-line bg-surface p-5" style={`--reveal-delay: ${index * 80}ms`}>
                    <h3 class="text-xl font-bold text-ink">{event.title}</h3>
                    <p class="mt-2 leading-7 text-muted">{event.body}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section id="agentic-ml" class="section-shell py-20 sm:py-28">
        <div class="reveal rounded-[2rem] bg-surface px-5 py-8 sm:px-8 sm:py-12 lg:px-12">
          <p class="section-label">Agentic ML</p>
          <h2 class="section-heading mt-4">
            A space to understand how AI is changing ML engineering.
          </h2>
          <p class="mt-5 max-w-5xl text-lg leading-8 text-muted">
            MLEN also talks about agentic ML: how AI agents, new tooling, and automated workflows are changing the way
            machine learning systems are built, evaluated, deployed, and maintained.
          </p>
        </div>
      </section>

    </main>

    <footer class="border-t border-sky-line py-8">
      <div class="section-shell flex flex-col gap-4 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
        <p>© 2026 MLEN</p>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel={externalRel}
                class="font-semibold transition hover:text-ink"
                aria-label={`${link.label}: ${link.description}`}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const revealItems = Array.from(document.querySelectorAll('.reveal'));
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!('IntersectionObserver' in window) || prefersReducedMotion) {
          revealItems.forEach((item) => item.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) {
                return;
              }

              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          {
            rootMargin: '0px 0px -12% 0px',
            threshold: 0.12,
          }
        );

        revealItems.forEach((item) => observer.observe(item));
        const handlePageHide = (event) => {
          if (event.persisted) {
            return;
          }

          observer.disconnect();
          window.removeEventListener('pagehide', handlePageHide);
        };
        window.addEventListener('pagehide', handlePageHide);
      })();
    </script>
  </body>
</html>
