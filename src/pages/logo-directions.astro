---
import '../styles/global.css';

const logoDirections = [
  {
    title: 'Polished Community Network',
    file: '/assets/logos/mlen-polished-community-network.svg',
    note: 'A cleaner version of the attached logo: abstract engineer nodes, calmer neural-network lines, and one central code node.',
  },
  {
    title: 'Imagegen Concept',
    file: '/assets/logos/mlen-imagegen-logo-concept.png',
    note: 'AI-generated concept sheet with a standalone M-shaped node icon and a horizontal MLEN wordmark lockup.',
  },
  {
    title: 'Neural Monogram',
    file: '/assets/logos/mlen-neural-monogram.svg',
    note: 'The strongest simple-logo candidate: an M-shaped network with a clear MLEN wordmark.',
  },
  {
    title: 'Community Node',
    file: '/assets/logos/mlen-community-node.svg',
    note: 'Closest to the original idea, but simplified into abstract people connected to a code node.',
  },
  {
    title: 'Engineering Badge',
    file: '/assets/logos/mlen-engineering-badge.svg',
    note: 'A compact badge direction for profile images, stickers, event slides, and Discord.',
  },
  {
    title: 'Code Network',
    file: '/assets/logos/mlen-code-network.svg',
    note: 'A more technical mark that combines code brackets with a small neural graph.',
  },
  {
    title: 'Signal Wordmark',
    file: '/assets/logos/mlen-signal-wordmark.svg',
    note: 'A wordmark-first option where the network signal supports the name instead of competing with it.',
  },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MLEN logo direction concepts." />
    <title>MLEN Logo Directions</title>
  </head>
  <body>
    <main class="section-shell py-12 sm:py-16">
      <a class="header-link inline-flex" href="/">Back to site</a>
      <section class="mt-10">
        <p class="section-label">Logo directions</p>
        <h1 class="mt-4 max-w-4xl text-[38px] font-bold leading-[1.04] text-ink sm:text-[54px]">
          Seven simplified MLEN identity concepts.
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">
          Each direction keeps the neural-network community idea, removes the illustration complexity, and uses a
          restrained technical palette.
        </p>
      </section>

      <section class="mt-12 grid gap-6 lg:grid-cols-2">
        {
          logoDirections.map((direction) => (
            <article class="soft-card">
              <div class="flex min-h-[230px] items-center justify-center rounded-2xl bg-white p-6">
                <img src={direction.file} alt={`${direction.title} MLEN logo direction`} class="w-full" loading="lazy" />
              </div>
              <h2 class="mt-6 text-2xl font-bold text-ink">{direction.title}</h2>
              <p class="mt-3 leading-7 text-muted">{direction.note}</p>
              <a class="mt-5 inline-flex font-bold text-leaf transition hover:text-leaf-dark" href={direction.file}>
                Open asset
              </a>
            </article>
          ))
        }
      </section>
    </main>
  </body>
</html>
