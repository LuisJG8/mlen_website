---
import {
  accentBrainEdges,
  brainBounds,
  brainEdges,
  brainNodeRadius,
  brainNodes,
  getBrainEdgeKey,
} from '../content/brain';
---

<div class="brain-map reveal" style="--reveal-delay: 120ms">
  <div class="brain-stage" aria-label="Interactive MLEN community brain map">
    <svg class="brain-fallback" viewBox={`0 0 ${brainBounds.width} ${brainBounds.height}`} aria-hidden="true">
      {
        brainEdges.map(([sourceId, targetId]) => {
          const source = brainNodes.find((node) => node.id === sourceId);
          const target = brainNodes.find((node) => node.id === targetId);

          if (!source || !target) {
            return null;
          }

          return (
            <line
              class={accentBrainEdges.has(getBrainEdgeKey(sourceId, targetId)) ? 'brain-fallback-line is-accent' : 'brain-fallback-line'}
              x1={source.x}
              y1={source.y}
              x2={target.x}
              y2={target.y}
            />
          );
        })
      }
      {
        brainNodes.map((node) => (
          <circle
            class={node.tone === 'cyan' ? 'brain-fallback-node is-cyan' : 'brain-fallback-node is-dark'}
            cx={node.x}
            cy={node.y}
            r={brainNodeRadius[node.size]}
          />
        ))
      }
    </svg>
    <canvas class="brain-canvas" data-brain-canvas aria-hidden="true"></canvas>
  </div>
</div>

<script
  type="application/json"
  id="brain-network-data"
  is:inline
  set:html={JSON.stringify({ bounds: brainBounds, nodes: brainNodes, edges: brainEdges })}
/>
