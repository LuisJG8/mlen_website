---
import {
  accentBrainEdges,
  brainBounds,
  brainEdges,
  brainNodeRadius,
  brainNodes,
  brainTopics,
  getBrainEdgeKey,
} from '../content/brain';
---

<div class="brain-map reveal" style="--reveal-delay: 120ms">
  <div class="brain-stage" aria-label="Interactive MLEN community brain map">
    <svg class="brain-fallback" viewBox={`0 0 ${brainBounds.width} ${brainBounds.height}`} aria-hidden="true">
      {
        brainEdges.map(([sourceId, targetId]) => {
          const source = brainNodes.find((node) => node.id === sourceId);
          const target = brainNodes.find((node) => node.id === targetId);

          if (!source || !target) {
            return null;
          }

          return (
            <line
              class={accentBrainEdges.has(getBrainEdgeKey(sourceId, targetId)) ? 'brain-fallback-line is-accent' : 'brain-fallback-line'}
              x1={source.x}
              y1={source.y}
              x2={target.x}
              y2={target.y}
            />
          );
        })
      }
      {
        brainNodes.map((node) => (
          <circle
            class={node.tone === 'cyan' ? 'brain-fallback-node is-cyan' : 'brain-fallback-node is-dark'}
            cx={node.x}
            cy={node.y}
            r={brainNodeRadius[node.size]}
          />
        ))
      }
    </svg>
    <canvas class="brain-canvas" data-brain-canvas aria-hidden="true"></canvas>
    <div class="brain-node-layer">
      {
        brainNodes.map((node) => {
          const topic = node.interactive ? brainTopics[node.id] : null;
          const x = (node.x / brainBounds.width) * 100;
          const y = (node.y / brainBounds.height) * 100;

          if (!topic) {
            return (
              <span
                class={`brain-node brain-node-${node.size} brain-node-static`}
                data-brain-node-id={node.id}
                style={`--x: ${x}%; --y: ${y}%;`}
                aria-hidden="true"
              ></span>
            );
          }

          return (
            <button
              type="button"
              class={`brain-node brain-node-${node.size}`}
              style={`--x: ${x}%; --y: ${y}%;`}
              data-brain-node-id={node.id}
              data-topic-index={node.id}
              data-title={topic.title}
              data-body={topic.body}
              aria-pressed={node.id === 0 ? 'true' : 'false'}
              aria-label={`Show ${topic.title}`}
            >
              <span class="sr-only">{topic.title}</span>
            </button>
          );
        })
      }
    </div>
  </div>

  <aside class="brain-detail" aria-live="polite">
    <p class="brain-detail-kicker">Selected node</p>
    <h3 data-brain-title>{brainTopics[0].title}</h3>
    <p data-brain-body>{brainTopics[0].body}</p>
  </aside>
</div>

<script
  type="application/json"
  id="brain-network-data"
  is:inline
  set:html={JSON.stringify({ bounds: brainBounds, nodes: brainNodes, edges: brainEdges })}
/>
